# Copy this file to .env only for a NEW installation.
# Existing installations: keep the current .env unchanged.
APP_NAME="Cape Ranch Management System"
APP_ENV=development
# Supply your PostgreSQL credentials locally; URL-encode special password characters.
DATABASE_URL="postgresql+psycopg2://postgres:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/ranching_fattening_2026"
CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
SESSION_HOURS=12
REMEMBER_DAYS=30
COOKIE_SECURE=false
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT=10

# First-time platform owner setup: set a random value before public deployment.
# APP_ENV=production requires a matching bootstrap token on owner creation.
APP_ENV=development
CAPE_BOOTSTRAP_TOKEN=
